# FaithQuest frontend environment — copy to `.env.local` and edit.

# Where the reverse proxy forwards `/api/v1/*` — see `next.config.mjs`.
# Server-side only (no `NEXT_PUBLIC_` prefix, so it never reaches the browser).
API_PROXY_TARGET=http://localhost:3001

# Origin of the NestJS backend, ONLY when it is on a different origin from this
# app (a deployed API, say). Leave it unset for normal use: with no API URL the
# browser calls this app same-origin and the proxy does the rest, which is what
# makes a phone work — an absolute origin means `localhost:3001` from a phone,
# i.e. the phone itself, so joins never reach the server.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Set to `off` to run with no backend at all: gameplay keeps working against
# localStorage exactly as before, and sign-in, server sync and the creator's
# progress report are disabled.
# NEXT_PUBLIC_API_PROXY=off
