# FaithQuest backend — environment template. Copy to `.env` (never committed).
#   cp .env.example .env

# ------------------------------------------------------------------ MySQL 8
# Aiven-hosted MySQL 8 (TLS required). `ssl-mode=REQUIRED` is honoured explicitly
# in `src/prisma/mariadbConfig.ts`; the local `db` service from docker-compose
# (`docker compose --profile local-db up db`) speaks the same protocol.
DATABASE_URL="mysql://avnadmin:CHANGE_ME@mysql-157743b9-raj45colaco-954f.g.aivencloud.com:18082/defaultdb?ssl-mode=REQUIRED"

# ---------------------------------------------------------------- JWT secrets
# Generate with: openssl rand -base64 48
# NEVER reuse the example values, and never expose them to the frontend.
JWT_SECRET="dev-only-change-me-access-secret"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ------------------------------------------------------------------- HTTP/CORS
PORT=3001
# Comma-separated list of allowed origins. Never use "*" in production.
CORS_ORIGIN="http://localhost:3000, https://constant-leading-white-interstate.trycloudflare.com"

# ------------------------------------------------------------------ bootstrap
# Origin used when building share links (the frontend origin).
FRONTEND_ORIGIN="http://localhost:3000, https://constant-leading-white-interstate.trycloudflare.com"
# Hides Swagger when set to "production".
NODE_ENV=development